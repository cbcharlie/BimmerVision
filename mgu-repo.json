{
  "schema": 1,
  "components": [
    {
      "id": "bimmervision",
      "kind": "app",
      "title": "BimmerVision",
      "path": "idrive",
      "manifest": "mgu-app.json",
      "icon": "store-icon.png",
      "requires": {
        "bimmervision-recorder": "0.2.79"
      },
      "build": {
        "node": "idrive/build-store.js",
        "output": "idrive/store-output.tgz"
      }
    },
    {
      "id": "bimmervision-recorder",
      "kind": "tool",
      "title": "BimmerVision Recorder",
      "path": "recorder",
      "optional": true
    }
  ]
}
